# Universal editor settings for this library.
# See https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.ps1]
indent_style = space
indent_size = 4

[*.psm1]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,psd1}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
# Generated tables intentionally use long lines.
max_line_length = off
