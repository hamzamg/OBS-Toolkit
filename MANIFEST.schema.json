{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://obs-toolkit.local/MANIFEST.schema.json",
  "title": "OBS Toolkit Library Manifest",
  "description": "Single source of truth for the offline OBS Toolkit library. Every path, hash and status in the library is derived from this file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "library_name",
    "schema_version",
    "platform",
    "generated_at",
    "environment",
    "tools"
  ],
  "properties": {
    "library_name": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "pattern": "^2\\.0$" },
    "platform": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_mode",
        "obs_version",
        "obs_portable",
        "obs_arch",
        "obs_install_dir",
        "python_interpreters",
        "websocket_bundled_version",
        "obs_python_range",
        "obs_lua_version"
      ],
      "properties": {
        "agent_mode": { "type": "string", "enum": ["full", "library-only", "plan-only"] },
        "obs_version": { "type": ["string", "null"] },
        "obs_portable": { "type": ["boolean", "null"] },
        "obs_arch": { "type": ["string", "null"] },
        "obs_install_dir": { "type": ["string", "null"] },
        "python_interpreters": {
          "type": "array",
          "items": { "type": "string" }
        },
        "websocket_bundled_version": { "type": ["string", "null"] },
        "obs_python_range": { "type": ["string", "null"] },
        "obs_lua_version": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/tool" }
    }
  },
  "definitions": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "folder",
        "category",
        "type",
        "decision",
        "decision_reason",
        "repository",
        "release",
        "license",
        "compatibility",
        "maintenance_status",
        "dependencies",
        "assets",
        "source_snapshot",
        "security",
        "approval_required_for",
        "installation_status",
        "tested_by_agent",
        "retrieved_at_utc",
        "sources"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "folder": {
          "type": "string",
          "pattern": "^([0-9]{2}-[A-Za-z-]+/[A-Za-z0-9._-]+|10-Unverified/[A-Za-z0-9._-]+)$"
        },
        "category": {
          "type": "string",
          "enum": [
            "scene-management",
            "scripting-and-automation",
            "timers-and-counters",
            "recording-and-organization",
            "screen-production",
            "audio-and-media",
            "streaming",
            "remote-control-and-ai"
          ]
        },
        "type": {
          "type": "string",
          "enum": ["lua-script", "python-script", "plugin", "external-app", "mcp-server", "docs-only"]
        },
        "decision": {
          "type": "string",
          "enum": ["INCLUDED", "UNVERIFIED", "REJECTED", "UNAVAILABLE", "DOCS-ONLY", "PENDING-USER"]
        },
        "decision_reason": { "type": "string", "minLength": 1 },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "owner",
            "default_branch",
            "archived",
            "is_fork",
            "fork_of",
            "last_commit_date",
            "last_release_date"
          ],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "owner": { "type": "string", "minLength": 1 },
            "default_branch": { "type": "string", "minLength": 1 },
            "archived": { "type": "boolean" },
            "is_fork": { "type": "boolean" },
            "fork_of": { "type": ["string", "null"] },
            "last_commit_date": { "type": ["string", "null"], "format": "date-time" },
            "last_release_date": { "type": ["string", "null"], "format": "date-time" }
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "url", "published_at", "prerelease", "commit_sha"],
          "properties": {
            "tag": { "type": ["string", "null"] },
            "url": { "type": ["string", "null"], "format": "uri" },
            "published_at": { "type": ["string", "null"], "format": "date-time" },
            "prerelease": { "type": "boolean" },
            "commit_sha": { "type": ["string", "null"], "pattern": "^([0-9a-f]{40})?$" }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "file_path", "status", "third_party", "notes"],
          "properties": {
            "spdx": { "type": ["string", "null"] },
            "file_path": { "type": ["string", "null"] },
            "status": { "type": "string", "enum": ["CONFIRMED", "UNVERIFIED", "ABSENT"] },
            "third_party": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "license", "note"],
                "properties": {
                  "name": { "type": "string" },
                  "license": { "type": "string" },
                  "note": { "type": "string" }
                }
              }
            },
            "notes": { "type": "string" }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "obs_min",
            "obs_max_documented",
            "python",
            "lua",
            "windows11_x64",
            "evidence",
            "notes"
          ],
          "properties": {
            "status": { "type": "string", "enum": ["SUPPORTED", "LIKELY", "UNKNOWN", "INCOMPATIBLE"] },
            "obs_min": { "type": ["string", "null"] },
            "obs_max_documented": { "type": ["string", "null"] },
            "python": { "type": ["string", "null"] },
            "lua": { "type": ["string", "null"] },
            "windows11_x64": { "type": "string", "enum": ["SUPPORTED", "LIKELY", "UNKNOWN", "INCOMPATIBLE"] },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["claim", "source"],
                "properties": {
                  "claim": { "type": "string" },
                  "source": { "type": "string" }
                }
              }
            },
            "notes": { "type": "string" }
          }
        },
        "maintenance_status": {
          "type": "string",
          "enum": ["ACTIVE", "STALE", "ARCHIVED", "DEPRECATED"]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "license", "required"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": ["string", "null"] },
              "license": { "type": ["string", "null"] },
              "required": { "type": "boolean" }
            }
          }
        },
        "assets": {
          "type": "array",
          "items": { "$ref": "#/definitions/asset" }
        },
        "source_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["local_path", "ref", "commit_sha"],
          "properties": {
            "local_path": { "type": ["string", "null"] },
            "ref": { "type": ["string", "null"] },
            "commit_sha": { "type": ["string", "null"], "pattern": "^([0-9a-f]{40})?$" }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "required": ["risk_level", "network_access", "spawns_processes", "findings"],
          "properties": {
            "risk_level": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
            "network_access": { "type": "string", "minLength": 1 },
            "spawns_processes": { "type": ["boolean", "null"] },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["category", "location", "note"],
                "properties": {
                  "category": {
                    "type": "string",
                    "enum": [
                      "code-execution",
                      "process-spawn",
                      "network",
                      "persistence",
                      "input-hooks",
                      "credentials",
                      "file-write",
                      "file-outside",
                      "obfuscation",
                      "provenance"
                    ]
                  },
                  "location": { "type": "string", "minLength": 1 },
                  "note": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "approval_required_for": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "installation_status": { "type": "string", "enum": ["not-installed"] },
        "tested_by_agent": { "type": "boolean", "const": false },
        "retrieved_at_utc": { "type": "string", "format": "date-time" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url", "retrieved_at_utc"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 1 },
              "retrieved_at_utc": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "url",
        "size_bytes",
        "downloaded_at",
        "local_path",
        "sha256",
        "reference_checksum",
        "signature",
        "verification_status",
        "alternative_asset"
      ],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "url": { "type": ["string", "null"], "format": "uri" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "downloaded_at": { "type": ["string", "null"], "format": "date-time" },
        "local_path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "reference_checksum": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "value", "match"],
          "properties": {
            "source": { "type": "string", "enum": ["PUBLISHER", "PLATFORM", "NONE"] },
            "value": { "type": ["string", "null"] },
            "match": { "type": ["boolean", "null"] }
          }
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "status", "signer"],
          "properties": {
            "type": { "type": "string", "enum": ["authenticode", "gpg", "sigstore", "attestation", "none"] },
            "status": { "type": "string", "enum": ["valid", "invalid", "unsigned", "not-checked"] },
            "signer": { "type": ["string", "null"] }
          }
        },
        "verification_status": {
          "type": "string",
          "enum": ["VERIFIED", "INTEGRITY-ONLY", "COMPUTED-ONLY", "FAILED", "NOT-DOWNLOADED"]
        },
        "alternative_asset": { "type": ["string", "null"] }
      }
    }
  }
}
